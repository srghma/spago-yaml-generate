/**
 * Recursively find all 'spago.yaml' files in a given directory.
 * @param {string} dir - Directory to start the search from.
 * @returns {string[]} - Array of file paths.
 */
function findSpagoFiles(dir) {
  // let results = [];
  //
  // // Read all items in the directory
  // const list = fs.readdirSync(dir);
  // list.forEach((file) => {
  //   const filePath = path.join(dir, file);
  //   const stat = fs.statSync(filePath);
  //
  //   // If it's a directory, recurse into it
  //   if (stat && stat.isDirectory()) {
  //     results = results.concat(findSpagoFiles(filePath));
  //   } else if (file === 'spago.yaml') {
  //     results.push(filePath);
  //   }
  // });
  //
  // return results;
  //
}

async function main() {
  const projectRoots = immediateDirs(projectsDir);
  const spagoFilesNotIgnored = (await Promise.all(projectRoots.map(spagoFilesNotIgnoredByGit))).flat();
  const namePathPairs = (await Promise.all(spagoFilesNotIgnored.map(readSpagoFileAndReturnPathAndName))).filter(Boolean); // Filter out null values

  // Output the result
  // console.log(namePathPairs);

  // for all namePathPairs
  // generate yaml like
  //
  //   tldr:
  //     path: dir
  //     subdir: subdir # if present

  const yamlData = {};

  namePathPairs.forEach(({ name, spagoYamlPath }) => {
    const path = spagoYamlPath.replace(/\/spago\.yaml$/, ''); // Using replace method

    yamlData[name] = {
      path
    };
  });

  // Convert the object to YAML format
  const yamlOutput = YAML.stringify(yamlData);

  // Output the YAML to console
  // console.log(yamlData);
  console.log(yamlOutput);

  fs.writeFileSync(path.join(projectsDir, 'spago-myglobal.yaml'), yamlOutput, 'utf8');
}

main()
